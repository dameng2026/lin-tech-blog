<script setup>
import { ref, reactive } from 'vue'

const props = defineProps({
  visible: {
    type: Boolean,
    default: false
  }
})

const emit = defineEmits(['close', 'login', 'register', 'reset-password'])

// ---- 视图状态 ----
// 支持: 'login' | 'register' | 'codeLogin' | 'forgotPassword'
const currentForm = ref('login')

// ---- 密码显示切换 ----
const showLoginPassword = ref(false)
const showRegisterPassword = ref(false)
const showNewPassword = ref(false)

// ---- 验证码倒计时 ----
const loginCodeCountdown = ref(0)
const forgotCodeCountdown = ref(0)
let loginCodeTimer = null
let forgotCodeTimer = null

const startCodeCountdown = (type) => {
  if (type === 'login') {
    if (loginCodeCountdown.value > 0) return
    loginCodeCountdown.value = 60
    loginCodeTimer = setInterval(() => {
      loginCodeCountdown.value--
      if (loginCodeCountdown.value <= 0) {
        clearInterval(loginCodeTimer)
        loginCodeTimer = null
      }
    }, 1000)
  } else if (type === 'forgot') {
    if (forgotCodeCountdown.value > 0) return
    forgotCodeCountdown.value = 60
    forgotCodeTimer = setInterval(() => {
      forgotCodeCountdown.value--
      if (forgotCodeCountdown.value <= 0) {
        clearInterval(forgotCodeTimer)
        forgotCodeTimer = null
      }
    }, 1000)
  }
}

// ---- 重置成功状态 ----
const resetSuccess = ref(false)

// ---- 表单数据 ----
const loginForm = reactive({
  email: '',
  password: '',
  remember: true
})

const codeLoginForm = reactive({
  email: '',
  code: ''
})

const registerForm = reactive({
  username: '',
  email: '',
  password: '',
  confirmPassword: '',
  agree: false
})

const forgotForm = reactive({
  email: '',
  code: '',
  newPassword: '',
  confirmPassword: ''
})

// ---- 事件处理 ----
const handleClose = () => {
  emit('close')
}

const handleLogin = () => {
  if (!loginForm.email || !loginForm.password) {
    alert('请填写完整的登录信息')
    return
  }
  emit('login', { ...loginForm })
}

const handleCodeLogin = () => {
  if (!codeLoginForm.email) {
    alert('请输入邮箱地址')
    return
  }
  if (!codeLoginForm.code) {
    alert('请输入验证码')
    return
  }
  emit('login', { ...codeLoginForm, type: 'code' })
}

const handleRegister = () => {
  if (!registerForm.username || !registerForm.email || !registerForm.password) {
    alert('请填写完整的注册信息')
    return
  }
  if (registerForm.password !== registerForm.confirmPassword) {
    alert('两次输入的密码不一致')
    return
  }
  if (!registerForm.agree) {
    alert('请阅读并同意服务条款和隐私政策')
    return
  }
  emit('register', { ...registerForm })
}

const handleResetPassword = () => {
  if (!forgotForm.email) {
    alert('请输入邮箱地址')
    return
  }
  if (!forgotForm.code) {
    alert('请输入验证码')
    return
  }
  if (!forgotForm.newPassword) {
    alert('请输入新密码')
    return
  }
  if (forgotForm.newPassword !== forgotForm.confirmPassword) {
    alert('两次输入的密码不一致')
    return
  }
  emit('reset-password', { ...forgotForm })
  resetSuccess.value = true
  setTimeout(() => {
    resetSuccess.value = false
    currentForm.value = 'login'
    // 重置表单
    forgotForm.email = ''
    forgotForm.code = ''
    forgotForm.newPassword = ''
    forgotForm.confirmPassword = ''
  }, 2000)
}
</script>

